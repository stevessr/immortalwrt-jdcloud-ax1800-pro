#!/bin/sh
# No credentials belong in an image or public build artifact.
. /lib/functions.sh
[ "$(board_name)" = 'jdcloud,re-ss-01' ] || exit 0

if [ -x /usr/bin/fish ]; then
	sed -i '/^root:/s|:[^:]*$|:/usr/bin/fish|' /etc/passwd
	grep -qxF /usr/bin/fish /etc/shells 2>/dev/null || echo /usr/bin/fish >> /etc/shells
fi
# Keep /bin/sh as ash: init, sysupgrade and package scripts require POSIX shell.
uci set system.@system[0].hostname='sakura'
uci set firewall.@defaults[0].flow_offloading='0'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci commit system
uci commit firewall

# Leave third-party service UCI flags and init autostart links untouched.
# Their packaged defaults and user choices control whether they run.

configure_ap() {
	local section="$1" mode option
	config_get mode "$section" mode
	[ "$mode" = ap ] || return 0
	# An open AP must not inherit WPA3/PSK options from earlier defaults.
	uci set "wireless.$section.ssid=sakura"
	uci set "wireless.$section.encryption=none"
	uci set "wireless.$section.wps_pushbutton=0"
	for option in key sae_password_file sae_pwe ieee80211w wpa_psk_file; do
		uci -q delete "wireless.$section.$option"
	done
	uci set "wireless.$section.disabled=0"
}
configure_radio() {
	uci set "wireless.$1.disabled=0"
}
if [ -f /etc/config/wireless ]; then
	config_load wireless
	config_foreach configure_ap wifi-iface
	config_foreach configure_radio wifi-device
	uci commit wireless
fi
exit 0
