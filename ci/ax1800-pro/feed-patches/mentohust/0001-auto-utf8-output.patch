+static int utf8_is_valid(const unsigned char *text, unsigned int length)
+{
+	unsigned int i = 0;
+
+	while (i < length) {
+		unsigned char c = text[i];
+		unsigned char next;
+
+		if (c < 0x80) {
+			i++;
+			continue;
+		}
+
+		if (c >= 0xc2 && c <= 0xdf) {
+			if (length - i < 2 || (text[i + 1] & 0xc0) != 0x80)
+				return 0;
+			i += 2;
+		} else if (c >= 0xe0 && c <= 0xef) {
+			if (length - i < 3)
+				return 0;
+			next = text[i + 1];
+			if ((next & 0xc0) != 0x80 || (text[i + 2] & 0xc0) != 0x80 ||
+			    (c == 0xe0 && next < 0xa0) || (c == 0xed && next >= 0xa0))
+				return 0;
+			i += 3;
+		} else if (c >= 0xf0 && c <= 0xf4) {
+			if (length - i < 4)
+				return 0;
+			next = text[i + 1];
+			if ((next & 0xc0) != 0x80 || (text[i + 2] & 0xc0) != 0x80 ||
+			    (text[i + 3] & 0xc0) != 0x80 ||
+			    (c == 0xf0 && next < 0x90) || (c == 0xf4 && next > 0x8f))
+				return 0;
+			i += 4;
+		} else {
+			return 0;
+		}
+	}
+
+	return 1;
+}
+
+int text_to_utf8(const char *from, unsigned int from_len, char **to,
+		 unsigned int *to_len)
+{
+	static int tables_initialized;
+	char *result;
+	unsigned int result_len;
+
+	if (from == NULL || from_len == 0 || to == NULL || to_len == NULL)
+		return -1;
+
+	*to = NULL;
+	*to_len = 0;
+
+	if (utf8_is_valid((const unsigned char *)from, from_len)) {
+		if (from_len == UINT_MAX)
+			return -1;
+
+		result = malloc((size_t)from_len + 1);
+		if (result == NULL)
+			return -1;
+
+		memcpy(result, from, from_len);
+		result[from_len] = '\0';
+		*to = result;
+		*to_len = from_len;
+		return 0;
+	}
+
+	if (from_len > (UINT_MAX - 1U) / 3U)
+		return -1;
+
+	result = malloc((size_t)from_len * 3U + 1U);
+	if (result == NULL)
+		return -1;
+
+	if (!tables_initialized) {
+		str_normalize_init();
+		tables_initialized = 1;
+	}
+
+	result_len = from_len * 3U + 1U;
+	if (gbk_to_utf8(from, from_len, &result, &result_len) != 0) {
+		free(result);
+		return -1;
+	}
+
+	*to = result;
+	*to_len = result_len;
+	return 0;
+}
+
 // vim: foldmethod=marker
 
