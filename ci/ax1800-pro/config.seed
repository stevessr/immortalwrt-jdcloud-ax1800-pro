CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_luci-app-iperf3=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fastfetch=y
CONFIG_PACKAGE_fish=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_bpftool-full=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-ikconfig=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
# qca-nss-qdisc links against nss_igs_* exports; the core driver builds IGS
# only when this package is selected (see DisableNssDrvFeatureWithoutPackages).
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
